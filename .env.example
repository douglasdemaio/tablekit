# Runtime environment: development or production.
TABLEKIT_ENV=development

# Public address of the HTTP server.
TABLEKIT_HTTP_ADDR=:8080

# Base domain used for merchant subdomains and WebAuthn.
TABLEKIT_BASE_DOMAIN=tablekit.de
TABLEKIT_PUBLIC_SCHEME=https

# Migrations and application use different database roles on purpose.
# The application role must NOT be a superuser and must NOT have BYPASSRLS.
TABLEKIT_DATABASE_URL=postgres://tablekit_app:tablekit_dev_app@localhost:55432/tablekit?sslmode=disable
# Owner DSN, only used by cmd/migrate and cmd/worker.
TABLEKIT_MIGRATE_DATABASE_URL=postgres://postgres:devpass@localhost:55432/tablekit?sslmode=disable

# 32 bytes encoded as base64. Generate with: openssl rand -base64 32
# Development only; production must supply this from a secret manager or KMS.
TABLEKIT_ENCRYPTION_KEY=

# Session lifetime as a Go duration.
TABLEKIT_SESSION_TTL=12h
TABLEKIT_MFA_PENDING_TTL=10m

# WebAuthn relying party. In development the browser origin is usually
# http://localhost:8080, so set TABLEKIT_WEBAUTHN_RP_ID=localhost.
TABLEKIT_WEBAUTHN_RP_ID=localhost
TABLEKIT_WEBAUTHN_RP_NAME=tablekit
TABLEKIT_WEBAUTHN_ORIGINS=http://localhost:8080

# Enable only behind TLS in production. Defaults to true when
# TABLEKIT_ENV=production.
TABLEKIT_COOKIE_SECURE=false

# Set to false on a self-hosted install that does not use platform billing.
TABLEKIT_BILLING_ENABLED=false

# Stripe Connect platform credentials. Restaurants onboard their own connected
# accounts; only the platform key and non-secret account IDs are stored.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Development only. Disables process-local rate limits so local testing is not
# throttled. Never enable in production.
TABLEKIT_RATE_LIMIT_DISABLED=false

# Only enable when a trusted reverse proxy sets X-Forwarded-For.
TABLEKIT_TRUST_PROXY=false

# Optional. Only used when a tool needs to create or describe the app role.
TABLEKIT_APP_DB_USER=tablekit_app
TABLEKIT_APP_DB_PASSWORD=tablekit_dev_app
TABLEKIT_DB_NAME=tablekit

# Used by cmd/bootstrap to seed one merchant with an owner account.
# The owner must finish MFA setup on first login.
TABLEKIT_BOOTSTRAP_MERCHANT_NAME=Bamberger Testküche
TABLEKIT_BOOTSTRAP_SLUG=bamberg-test
TABLEKIT_BOOTSTRAP_HOST=bamberg-test.tk.local
TABLEKIT_BOOTSTRAP_EMAIL=owner@example.com
TABLEKIT_BOOTSTRAP_OWNER_NAME=Test Inhaber
TABLEKIT_BOOTSTRAP_PASSWORD=devpassword123

# S3-compatible media storage (e.g. MinIO)
TABLEKIT_S3_ENDPOINT=localhost:9000
TABLEKIT_S3_REGION=us-east-1
TABLEKIT_S3_BUCKET=tablekit-media
TABLEKIT_S3_ACCESS_KEY=
TABLEKIT_S3_SECRET_KEY=
TABLEKIT_S3_USE_SSL=false
