package templates

import "strconv"

templ StorefrontPage(p Page) {
	@Layout(p) {
		<div data-page="storefront" data-slug={ p.MerchantSlug } data-template={ p.Storefront.Template }>
			<section class="overflow-hidden rounded-3xl border border-stone-200 bg-white">
				if p.Storefront.CoverURL != "" {
					<img src={ p.Storefront.CoverURL } alt="" class="h-48 w-full object-cover"/>
				}
				<div class="p-8">
				<div class="flex flex-wrap items-start justify-between gap-4">
					<div class="flex items-start gap-4">
						if p.Storefront.LogoURL != "" {
							<img src={ p.Storefront.LogoURL } alt="" class="h-16 w-16 rounded-2xl object-cover"/>
						}
						<div>
							<h1 class="text-4xl font-semibold tracking-tight">{ p.Storefront.Name }</h1>
							if p.Storefront.Tagline != "" {
								<p class="mt-2 max-w-2xl text-stone-600">{ p.Storefront.Tagline }</p>
							}
							if p.Storefront.Cuisine != "" {
								<p class="mt-1 text-sm uppercase tracking-wide text-stone-500">{ p.Storefront.Cuisine }</p>
							}
						</div>
					</div>
					if p.Storefront.Open {
						<span class="rounded-full bg-emerald-100 px-3 py-1 text-sm font-medium text-emerald-800">{ p.T("storefront.open") }</span>
					} else {
						<span class="rounded-full bg-red-100 px-3 py-1 text-sm font-medium text-red-800">{ p.T("storefront.closed") }</span>
					}
				</div>
				if !p.Storefront.Open {
					<p class="mt-4 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800">{ p.T("storefront.closed_notice") }</p>
				}
				if p.Storefront.Description != "" {
					<p class="mt-4 max-w-3xl text-stone-600">{ p.Storefront.Description }</p>
				}
				if p.Storefront.Address != "" || p.Storefront.Phone != "" || p.Storefront.Email != "" {
					<div class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-sm text-stone-600">
						if p.Storefront.Address != "" {
							<span>{ p.Storefront.Address }</span>
						}
						if p.Storefront.Phone != "" {
							<a class="underline" href={ "tel:" + p.Storefront.Phone }>{ p.Storefront.Phone }</a>
						}
						if p.Storefront.Email != "" {
							<a class="underline" href={ "mailto:" + p.Storefront.Email }>{ p.Storefront.Email }</a>
						}
					</div>
				}
				if len(p.Storefront.Hours) > 0 {
					<div class="mt-6 grid gap-1 text-sm text-stone-600 sm:grid-cols-2">
						for _, h := range p.Storefront.Hours {
							<p><span class="font-medium text-stone-800">{ h.Day }</span> { h.Range }</p>
						}
					</div>
				}
				if len(p.Storefront.Zones) > 0 {
					<div class="mt-6 border-t border-stone-100 pt-4 text-sm text-stone-600">
						<p class="font-medium text-stone-800">{ p.T("storefront.delivery_areas") }</p>
						<ul class="mt-2 space-y-1">
							for _, z := range p.Storefront.Zones {
								<li>{ z.Name }: { z.Postcodes } · { p.T("storefront.fee") } { z.Fee } · { p.T("storefront.min_order") } { z.MinOrder }</li>
							}
						</ul>
					</div>
				}
				</div>
			</section>

			if len(p.Storefront.Menu) == 0 {
				<p class="mt-10 rounded-2xl border border-dashed border-stone-300 bg-white p-10 text-center text-stone-500">{ p.T("storefront.empty") }</p>
			} else {
				<div class="mt-10 grid gap-8 lg:grid-cols-[1fr_20rem]">
					<div class="space-y-8">
						for _, c := range p.Storefront.Menu {
							<section>
								<h2 class="text-2xl font-semibold tracking-tight">{ c.Name }</h2>
								if c.Description != "" {
									<p class="mt-1 text-sm text-stone-600">{ c.Description }</p>
								}
								<ul class="mt-4 space-y-3">
									for _, it := range c.Items {
										<li class="flex gap-4 rounded-2xl border border-stone-200 bg-white p-4">
											if it.ThumbURL != "" {
												<img src={ it.ThumbURL } alt="" class="h-20 w-20 rounded-xl object-cover" loading="lazy"/>
											}
											<div class="min-w-0 flex-1">
												<div class="flex items-start justify-between gap-3">
													<div>
														<h3 class="font-medium">{ it.Name }</h3>
														if it.Description != "" {
															<p class="mt-1 text-sm text-stone-600">{ it.Description }</p>
														}
													</div>
													<span class="whitespace-nowrap font-medium">{ it.Price }</span>
												</div>
												<div class="mt-3">
													if it.Available {
														<button type="button" class="rounded-lg bg-stone-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-stone-700"
															data-add={ it.ID } data-name={ it.Name } data-price={ it.Price }>
															{ p.T("storefront.add") }
														</button>
													} else {
														<span class="text-sm text-stone-500">{ it.SoldOutText }</span>
													}
												</div>
											</div>
										</li>
									}
								</ul>
							</section>
						}
					</div>

					<aside class="h-fit rounded-2xl border border-stone-200 bg-white p-5 lg:sticky lg:top-6" aria-live="polite">
						<div class="flex items-center justify-between">
							<h2 class="text-lg font-semibold">{ p.T("cart.title") }</h2>
							<span class="text-sm text-stone-500" data-cart-count></span>
						</div>
						<p class="mt-3 text-sm text-stone-500" data-cart-empty>{ p.T("cart.empty") }</p>
						<ul class="mt-3 divide-y divide-stone-100" data-cart-lines></ul>
						<div class="mt-4 flex items-center justify-between border-t border-stone-100 pt-3">
							<span class="text-sm text-stone-600">{ p.T("cart.total") }</span>
							<span class="font-semibold" data-cart-total></span>
						</div>
						<div class="mt-4 flex flex-col gap-2">
							<a href="/checkout" class="rounded-lg bg-stone-900 px-4 py-2 text-center text-sm font-medium text-white hover:bg-stone-700" data-cart-checkout>{ p.T("cart.checkout") }</a>
							<button type="button" class="rounded-lg border border-stone-300 px-4 py-2 text-sm font-medium hover:bg-stone-100" data-cart-clear>{ p.T("cart.clear") }</button>
						</div>
					</aside>
				</div>
			}
		</div>
	}
}

templ CheckoutPage(p Page) {
	@Layout(p) {
		<div data-page="checkout" data-slug={ p.MerchantSlug } data-template={ p.Checkout.Template }>
			<h1 class="text-3xl font-semibold tracking-tight">{ p.T("checkout.title") }</h1>
			<p class="mt-2 text-stone-600">{ p.T("checkout.subtitle") }</p>

			if !p.Checkout.Open {
				<p class="mt-6 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800">{ p.T("checkout.closed_notice") }</p>
			}

			<div class="mt-8 grid gap-8 lg:grid-cols-[1fr_22rem]">
				<form id="checkout-form" method="post" action="/orders" class="space-y-6 rounded-2xl border border-stone-200 bg-white p-6">
					<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
					<input type="hidden" name="cart" value=""/>

					<div class="rounded-lg bg-stone-50 px-4 py-3 text-sm text-stone-600">
						{ p.T("checkout.signed_in_as") } <span class="font-medium text-stone-900">{ p.Checkout.Customer }</span>
					</div>
					<div class="grid gap-3 sm:grid-cols-2">
						<div>
							<label class="block text-sm font-medium" for="name">{ p.T("checkout.name") }</label>
							<input id="name" name="name" required maxlength="120" autocomplete="name"
								class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2" placeholder={ p.T("checkout.name_placeholder") }/>
						</div>
						<div>
							<label class="block text-sm font-medium" for="phone">{ p.T("account.phone") }</label>
							<input id="phone" name="phone" value={ p.Checkout.Phone } maxlength="40" autocomplete="tel"
								class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
						</div>
					</div>

					<fieldset>
						<legend class="text-sm font-medium">{ p.T("checkout.fulfilment") }</legend>
						<div class="mt-2 flex flex-wrap gap-4">
							<label class="flex items-center gap-2 text-sm">
								<input type="radio" name="fulfilment" value="pickup" checked data-fulfilment="pickup"/>
								{ p.T("orders.pickup") }
							</label>
							if len(p.Checkout.Zones) > 0 {
								<label class="flex items-center gap-2 text-sm">
									<input type="radio" name="fulfilment" value="delivery" data-fulfilment="delivery"/>
									{ p.T("orders.self_delivery") }
								</label>
							}
						</div>
						if len(p.Checkout.Zones) > 0 {
							<div class="mt-3 space-y-3" data-delivery-fields hidden>
								if len(p.Checkout.Addresses) > 0 {
									<div>
										<label class="block text-sm font-medium" for="address_id">{ p.T("checkout.saved_address") }</label>
										<select id="address_id" name="address_id" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2">
											for _, a := range p.Checkout.Addresses {
												<option value={ a.ID } selected?={ a.IsDefault }>{ a.Label } — { a.Summary }</option>
											}
											<option value="">{ p.T("checkout.new_address") }</option>
										</select>
									</div>
								}
								<div class="grid gap-3 sm:grid-cols-2">
									<div>
										<label class="block text-sm font-medium" for="recipient">{ p.T("account.recipient") }</label>
										<input id="recipient" name="recipient" maxlength="120" autocomplete="name" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
									</div>
									<div>
										<label class="block text-sm font-medium" for="delivery_phone">{ p.T("account.phone") }</label>
										<input id="delivery_phone" name="delivery_phone" maxlength="40" autocomplete="tel" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
									</div>
									<div>
										<label class="block text-sm font-medium" for="line1">{ p.T("account.street") }</label>
										<input id="line1" name="line1" maxlength="200" autocomplete="address-line1" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
									</div>
									<div>
										<label class="block text-sm font-medium" for="postcode">{ p.T("checkout.postcode") }</label>
										<input id="postcode" name="postcode" maxlength="12" autocomplete="postal-code" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
									</div>
									<div>
										<label class="block text-sm font-medium" for="city">{ p.T("account.city") }</label>
										<input id="city" name="city" maxlength="120" autocomplete="address-level2" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
									</div>
									<div>
										<label class="block text-sm font-medium" for="country">{ p.T("account.country") }</label>
										<input id="country" name="country" value="DE" maxlength="2" autocomplete="country" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
									</div>
								</div>
								<div class="rounded-lg bg-stone-50 px-3 py-2 text-sm text-stone-600">
									<p class="font-medium text-stone-800">{ p.T("checkout.delivery_areas") }</p>
									<ul class="mt-1 space-y-1">
										for _, z := range p.Checkout.Zones {
											<li>{ z.Name }: { z.Postcodes } · { p.T("storefront.fee") } { z.Fee } · { p.T("storefront.min_order") } { z.MinOrder }</li>
										}
									</ul>
								</div>
							</div>
						}
					</fieldset>

					<div>
						<label class="block text-sm font-medium" for="scheduled_for">{ p.T("checkout.time") }</label>
						<select id="scheduled_for" name="scheduled_for" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2">
							<option value="asap">{ p.T("checkout.asap") }</option>
							for _, slot := range p.Checkout.Slots {
								<option value={ slot.Value }>{ slot.Label }</option>
							}
						</select>
					</div>

					<div>
						<label class="block text-sm font-medium" for="notes">{ p.T("checkout.notes") }</label>
						<textarea id="notes" name="notes" rows="2" maxlength="500"
							class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"></textarea>
					</div>

					<fieldset>
						<legend class="text-sm font-medium">{ p.T("checkout.payment") }</legend>
						<div class="mt-2 space-y-2 text-sm">
							<label class="flex items-center gap-2">
								<input type="radio" name="payment" value="cash" checked/>
								{ p.T("checkout.pay_cash") }
							</label>
							if p.Checkout.CardEnabled {
								<label class="flex items-center gap-2">
									<input type="radio" name="payment" value="card"/>
									{ p.T("checkout.pay_card") }
								</label>
							}
						</div>
						<p class="mt-2 rounded-lg bg-stone-50 px-4 py-3 text-sm text-stone-600">{ p.T("checkout.payment_note") }</p>
					</fieldset>

					<label class="flex items-start gap-2 text-sm">
						<input type="checkbox" name="share_profile" value="1" checked?={ p.Checkout.SharedHere }/>
						<span>{ p.T("checkout.share_profile") }</span>
					</label>

					<button type="submit" class="w-full rounded-lg bg-stone-900 px-4 py-3 font-medium text-white hover:bg-stone-700 disabled:opacity-50" data-checkout-submit>
						{ p.T("checkout.place_order") }
					</button>
				</form>

				<aside class="h-fit rounded-2xl border border-stone-200 bg-white p-5">
					<h2 class="text-lg font-semibold">{ p.T("cart.title") }</h2>
					<p class="mt-3 text-sm text-stone-500" data-cart-empty>{ p.T("cart.empty") }</p>
					<ul class="mt-3 divide-y divide-stone-100" data-cart-lines></ul>
					<div class="mt-4 flex items-center justify-between border-t border-stone-100 pt-3">
						<span class="text-sm text-stone-600">{ p.T("cart.total") }</span>
						<span class="font-semibold" data-cart-total></span>
					</div>
					<a href="/" class="mt-4 block text-center text-sm text-stone-500 underline">{ p.T("cart.continue") }</a>
				</aside>
			</div>
		</div>
	}
}

templ OrderPage(p Page) {
	@Layout(p) {
		<div data-page="order" data-slug={ p.MerchantSlug }>
			<div class="rounded-2xl border border-stone-200 bg-white p-8">
				<p class="text-sm uppercase tracking-wide text-stone-500">{ p.T("order.placed") }</p>
				<div class="mt-2 flex flex-wrap items-center gap-3">
					<h1 class="text-3xl font-semibold tracking-tight">{ p.Confirmation.Ref }</h1>
					@StatusBadge(p.Confirmation.Status)
				</div>
				<p class="mt-2 text-stone-600">{ p.T("order.thank_you") }</p>

				if p.Confirmation.Pickup {
					<div class="mt-6 rounded-2xl bg-amber-50 p-5">
						if p.Confirmation.Code != "" {
							<p class="text-sm font-medium text-amber-900">{ p.T("order.pickup_code") }</p>
							<p class="mt-1 font-mono text-4xl font-semibold tracking-[0.3em] text-amber-900">{ p.Confirmation.Code }</p>
							<p class="mt-2 text-sm text-amber-800">{ p.T("order.pickup_code_hint") }</p>
						} else {
							<p class="text-sm text-amber-900">{ p.T("order.pickup_code_missing") }</p>
						}
					</div>
				}

				<dl class="mt-6 grid gap-2 text-sm sm:grid-cols-2">
					<div><dt class="text-stone-500">{ p.T("checkout.name") }</dt><dd class="font-medium">{ p.Confirmation.Name }</dd></div>
					<div><dt class="text-stone-500">{ p.T("orders.fulfilment") }</dt><dd class="font-medium">{ p.Confirmation.Fulfilment }</dd></div>
				</dl>

				<ul class="mt-6 divide-y divide-stone-100 border-t border-stone-100">
					for _, line := range p.Confirmation.Items {
						<li class="flex items-center justify-between py-2 text-sm">
							<span><span class="font-medium">{ line.Quantity }×</span> { line.Name }</span>
							<span class="text-stone-500">{ line.Total }</span>
						</li>
					}
				</ul>
				<div class="mt-4 space-y-1 border-t border-stone-100 pt-3 text-sm">
					<div class="flex justify-between"><span class="text-stone-500">{ p.T("order.subtotal") }</span><span>{ p.Confirmation.Subtotal }</span></div>
					<div class="flex justify-between"><span class="text-stone-500">{ p.T("order.delivery_fee") }</span><span>{ p.Confirmation.Fee }</span></div>
					<div class="flex justify-between"><span class="text-stone-500">{ p.T("order.vat_included") }</span><span>{ p.Confirmation.Tax }</span></div>
					<div class="flex justify-between text-base font-semibold"><span>{ p.T("cart.total") }</span><span>{ p.Confirmation.Total }</span></div>
				</div>
			</div>
			<p class="mt-4 text-center text-sm text-stone-500"><a href="/" class="underline">{ p.T("cart.continue") }</a></p>
		</div>
	}
}

templ SettingsPage(p Page) {
	@Layout(p) {
		<h1 class="text-3xl font-semibold tracking-tight">{ p.T("settings.title") }</h1>
		<p class="mt-2 text-stone-600">{ p.T("settings.subtitle") }</p>

		<section class="mt-8 rounded-2xl border border-stone-200 bg-white p-6">
			<h2 class="text-lg font-semibold">{ p.T("settings.profile_heading") }</h2>
			<p class="mt-1 text-sm text-stone-600">{ p.T("settings.profile_hint") }</p>
			<form method="post" action="/dashboard/settings/profile" class="mt-4 grid gap-3 sm:grid-cols-2">
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
				<label class="text-sm">{ p.T("settings.profile_name") }
					<input name="name" value={ p.Settings.Profile.Name } required maxlength="160" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
				</label>
				<label class="text-sm">{ p.T("settings.profile_legal") }
					<input name="legal_name" value={ p.Settings.Profile.LegalName } maxlength="160" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
				</label>
				<label class="text-sm sm:col-span-2">{ p.T("settings.profile_description") }
					<textarea name="description" rows="3" maxlength="2000" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2">{ p.Settings.Profile.Description }</textarea>
				</label>
				<label class="text-sm">{ p.T("settings.profile_phone") }
					<input name="phone" value={ p.Settings.Profile.Phone } maxlength="40" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
				</label>
				<label class="text-sm">{ p.T("settings.profile_email") }
					<input name="email" type="email" value={ p.Settings.Profile.Email } maxlength="200" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
				</label>
				<label class="text-sm">{ p.T("account.street") }
					<input name="street" value={ p.Settings.Profile.Street } maxlength="200" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
				</label>
				<label class="text-sm">{ p.T("account.line2") }
					<input name="line2" value={ p.Settings.Profile.Line2 } maxlength="200" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
				</label>
				<label class="text-sm">{ p.T("account.postcode") }
					<input name="postcode" value={ p.Settings.Profile.Postcode } maxlength="20" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
				</label>
				<label class="text-sm">{ p.T("account.city") }
					<input name="city" value={ p.Settings.Profile.City } maxlength="120" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
				</label>
				<label class="text-sm">{ p.T("settings.profile_country") }
					<input name="country" value={ p.Settings.Profile.Country } maxlength="2" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
				</label>
				<label class="text-sm">{ p.T("settings.profile_cuisine") }
					<input name="cuisine" value={ p.Settings.Profile.Cuisine } maxlength="120" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
				</label>
				<label class="text-sm">{ p.T("settings.profile_timezone") }
					<input name="timezone" value={ p.Settings.Profile.Timezone } required class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
				</label>
				<label class="text-sm">{ p.T("settings.profile_locale") }
					<select name="locale" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2">
						<option value="en" selected?={ p.Settings.Profile.Locale == "en" }>English</option>
						<option value="de" selected?={ p.Settings.Profile.Locale == "de" }>Deutsch</option>
					</select>
				</label>
				<label class="flex items-center gap-2 text-sm"><input type="checkbox" name="pickup_enabled" checked?={ p.Settings.Profile.PickupEnabled }/> { p.T("settings.profile_pickup") }</label>
				<label class="flex items-center gap-2 text-sm"><input type="checkbox" name="self_delivery_enabled" checked?={ p.Settings.Profile.SelfDeliveryEnabled }/> { p.T("settings.profile_delivery") }</label>
				<div class="sm:col-span-2">
					<button type="submit" class="rounded-lg bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700">{ p.T("settings.save") }</button>
				</div>
			</form>
		</section>

		if p.Settings.CanBrand {
			<section class="mt-6 rounded-2xl border border-stone-200 bg-white p-6">
				<h2 class="text-lg font-semibold">{ p.T("settings.branding_heading") }</h2>
				<p class="mt-1 text-sm text-stone-600">{ p.T("settings.branding_hint") }</p>
				<form method="post" action="/dashboard/settings/branding" class="mt-4 grid gap-3 sm:grid-cols-2">
					<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
					<label class="text-sm sm:col-span-2">{ p.T("settings.branding_tagline") }
						<input name="tagline" value={ p.Settings.Brand.Tagline } maxlength="120" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
					</label>
					<label class="text-sm">{ p.T("settings.branding_primary") }
						<input name="primary_color" type="color" value={ p.Settings.Brand.PrimaryColor } class="mt-1 h-10 w-full rounded-lg border border-stone-300"/>
					</label>
					<label class="text-sm">{ p.T("settings.branding_secondary") }
						<input name="secondary_color" type="color" value={ p.Settings.Brand.SecondaryColor } class="mt-1 h-10 w-full rounded-lg border border-stone-300"/>
					</label>
					<label class="text-sm">{ p.T("settings.branding_accent") }
						<input name="accent_color" type="color" value={ p.Settings.Brand.AccentColor } class="mt-1 h-10 w-full rounded-lg border border-stone-300"/>
					</label>
					<label class="text-sm">{ p.T("settings.branding_background") }
						<input name="background_color" type="color" value={ p.Settings.Brand.Background } class="mt-1 h-10 w-full rounded-lg border border-stone-300"/>
					</label>
					<label class="text-sm">{ p.T("settings.branding_text") }
						<input name="text_color" type="color" value={ p.Settings.Brand.TextColor } class="mt-1 h-10 w-full rounded-lg border border-stone-300"/>
					</label>
					<label class="text-sm">{ p.T("settings.branding_font") }
						<select name="font" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2">
							<option value="Inter" selected?={ p.Settings.Brand.Font == "Inter" }>Inter</option>
							<option value="Playfair Display" selected?={ p.Settings.Brand.Font == "Playfair Display" }>Playfair Display</option>
							<option value="Lora" selected?={ p.Settings.Brand.Font == "Lora" }>Lora</option>
							<option value="DM Sans" selected?={ p.Settings.Brand.Font == "DM Sans" }>DM Sans</option>
							<option value="Cormorant Garamond" selected?={ p.Settings.Brand.Font == "Cormorant Garamond" }>Cormorant Garamond</option>
						</select>
					</label>
					<label class="text-sm">{ p.T("settings.branding_template") }
						<select name="template" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2">
							<option value="classic-bistro" selected?={ p.Settings.Brand.Template == "classic-bistro" }>Classic Bistro</option>
							<option value="modern-dark" selected?={ p.Settings.Brand.Template == "modern-dark" }>Modern Dark</option>
							<option value="warm-tavern" selected?={ p.Settings.Brand.Template == "warm-tavern" }>Warm Tavern</option>
						</select>
					</label>
					<div class="sm:col-span-2">
						<button type="submit" class="rounded-lg bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700">{ p.T("settings.save") }</button>
					</div>
				</form>
				<div class="mt-6 grid gap-4 border-t border-stone-100 pt-4 sm:grid-cols-2">
					<form method="post" action="/dashboard/settings/branding/logo" enctype="multipart/form-data" class="rounded-xl border border-stone-200 p-4">
						<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
						<h3 class="text-sm font-semibold">{ p.T("settings.branding_logo") }</h3>
						if p.Settings.Brand.LogoURL != "" {
							<img src={ p.Settings.Brand.LogoURL } alt="" class="mt-2 h-16 w-auto rounded"/>
						}
						<input type="file" name="image" accept="image/png,image/jpeg,image/webp" required class="mt-3 block w-full text-sm"/>
						<button type="submit" class="mt-3 rounded-lg border border-stone-300 px-3 py-2 text-sm hover:bg-stone-100">{ p.T("settings.upload") }</button>
					</form>
					<form method="post" action="/dashboard/settings/branding/cover" enctype="multipart/form-data" class="rounded-xl border border-stone-200 p-4">
						<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
						<h3 class="text-sm font-semibold">{ p.T("settings.branding_cover") }</h3>
						if p.Settings.Brand.CoverURL != "" {
							<img src={ p.Settings.Brand.CoverURL } alt="" class="mt-2 h-16 w-auto rounded"/>
						}
						<input type="file" name="image" accept="image/png,image/jpeg,image/webp" required class="mt-3 block w-full text-sm"/>
						<button type="submit" class="mt-3 rounded-lg border border-stone-300 px-3 py-2 text-sm hover:bg-stone-100">{ p.T("settings.upload") }</button>
					</form>
				</div>
			</section>
		}

		<section class="mt-6 rounded-2xl border border-stone-200 bg-white p-6">
			<h2 class="text-lg font-semibold">{ p.T("settings.payments_heading") }</h2>
			if !p.Settings.Payment.Available {
				<p class="mt-1 text-sm text-stone-600">{ p.T("settings.payments_not_enabled") }</p>
			} else if p.Settings.Payment.Active {
				<p class="mt-1 text-sm text-stone-600">{ p.T("settings.payments_active") }
					if p.Settings.Payment.LiveMode {
						<span class="ml-2 rounded-full bg-red-100 px-2 py-0.5 text-xs text-red-800">LIVE</span>
					}
				</p>
			} else {
				<p class="mt-1 text-sm text-stone-600">{ p.T("settings.payments_setup") }</p>
				<form method="post" action="/dashboard/settings/payments/connect" class="mt-4">
					<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
					<button type="submit" class="rounded-lg bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700">
						if p.Settings.Payment.Connected {
							{ p.T("settings.payments_continue") }
						} else {
							{ p.T("settings.payments_start") }
						}
					</button>
				</form>
			}
		</section>

		<section class="mt-8 rounded-2xl border border-stone-200 bg-white p-6">
			<h2 class="text-lg font-semibold">{ p.T("settings.vat_heading") }</h2>
			<p class="mt-1 text-sm text-stone-600">{ p.T("settings.vat_hint") }</p>
			<form method="post" action="/dashboard/settings/vat" class="mt-4 flex flex-wrap items-end gap-3">
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
				<div>
					<label class="block text-sm font-medium" for="vat">{ p.T("settings.vat_rate") }</label>
					<div class="mt-1 flex items-center gap-2">
						<input id="vat" name="vat" value={ p.Settings.VATPercent } required inputmode="decimal"
							class="w-28 rounded-lg border border-stone-300 px-3 py-2"/>
						<span class="text-sm text-stone-500">%</span>
					</div>
				</div>
				<button type="submit" class="rounded-lg bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700">{ p.T("settings.save") }</button>
			</form>
		</section>

		<section class="mt-6 rounded-2xl border border-stone-200 bg-white p-6">
			<h2 class="text-lg font-semibold">{ p.T("settings.hours_heading") }</h2>
			<p class="mt-1 text-sm text-stone-600">{ p.T("settings.hours_hint") }</p>
			<form method="post" action="/dashboard/settings/hours" class="mt-4 space-y-3">
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
				for _, h := range p.Settings.Hours {
					<div class="grid items-center gap-3 sm:grid-cols-[8rem_7rem_1rem_7rem]">
						<label class="flex items-center gap-2 text-sm">
							<input type="checkbox" name={ "day_" + strconv.Itoa(h.Weekday) + "_enabled" } checked?={ h.Enabled }/>
							{ h.Label }
						</label>
						<input type="time" name={ "day_" + strconv.Itoa(h.Weekday) + "_open" } value={ h.Opens }
							class="rounded-lg border border-stone-300 px-3 py-2 text-sm"/>
						<span class="text-center text-stone-400">–</span>
						<input type="time" name={ "day_" + strconv.Itoa(h.Weekday) + "_close" } value={ h.Closes }
							class="rounded-lg border border-stone-300 px-3 py-2 text-sm"/>
					</div>
				}
				<button type="submit" class="rounded-lg bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700">{ p.T("settings.save") }</button>
			</form>
		</section>

		<section class="mt-6 rounded-2xl border border-stone-200 bg-white p-6">
			<h2 class="text-lg font-semibold">{ p.T("settings.zones_heading") }</h2>
			<p class="mt-1 text-sm text-stone-600">{ p.T("settings.zones_hint") }</p>

			for _, z := range p.Settings.Zones {
				<form method="post" action={ templ.SafeURL("/dashboard/settings/zones/" + z.ID) } class="mt-4 grid gap-3 border-t border-stone-100 pt-4 sm:grid-cols-[1fr_1fr_7rem_7rem_auto_auto]">
					<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
					<input name="name" value={ z.Name } required class="rounded-lg border border-stone-300 px-3 py-2 text-sm" placeholder={ p.T("settings.zone_name") }/>
					<input name="prefixes" value={ z.Prefixes } required class="rounded-lg border border-stone-300 px-3 py-2 text-sm" placeholder={ p.T("settings.zone_prefixes") }/>
					<input name="min_order" value={ z.MinOrder } inputmode="decimal" class="rounded-lg border border-stone-300 px-3 py-2 text-sm" placeholder={ p.T("settings.zone_min") }/>
					<input name="fee" value={ z.Fee } inputmode="decimal" class="rounded-lg border border-stone-300 px-3 py-2 text-sm" placeholder={ p.T("settings.zone_fee") }/>
					<label class="flex items-center gap-2 text-sm">
						<input type="checkbox" name="active" checked?={ z.Active }/>
						{ p.T("settings.zone_active") }
					</label>
					<button type="submit" class="rounded-lg border border-stone-300 px-3 py-2 text-sm font-medium hover:bg-stone-100">{ p.T("settings.save") }</button>
				</form>
				<form method="post" action={ templ.SafeURL("/dashboard/settings/zones/" + z.ID + "/delete") } class="mt-2">
					<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
					<button type="submit" class="text-sm text-red-700 hover:underline">{ p.T("settings.zone_delete") }</button>
				</form>
			}

			<form method="post" action="/dashboard/settings/zones" class="mt-6 grid gap-3 border-t border-stone-200 pt-4 sm:grid-cols-[1fr_1fr_7rem_7rem_auto]">
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
				<input name="name" required class="rounded-lg border border-stone-300 px-3 py-2 text-sm" placeholder={ p.T("settings.zone_name") }/>
				<input name="prefixes" required class="rounded-lg border border-stone-300 px-3 py-2 text-sm" placeholder={ p.T("settings.zone_prefixes") }/>
				<input name="min_order" inputmode="decimal" class="rounded-lg border border-stone-300 px-3 py-2 text-sm" placeholder={ p.T("settings.zone_min") }/>
				<input name="fee" inputmode="decimal" class="rounded-lg border border-stone-300 px-3 py-2 text-sm" placeholder={ p.T("settings.zone_fee") }/>
				<button type="submit" class="rounded-lg bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700">{ p.T("settings.zone_add") }</button>
			</form>
		</section>
	}
}
