package templates

templ MenuPage(p Page) {
	@Layout(p) {
		<div class="flex flex-wrap items-end justify-between gap-4">
			<div>
				<h1 class="text-3xl font-semibold tracking-tight">{ p.T("menu.title") }</h1>
				<p class="mt-2 text-stone-600">{ p.T("menu.subtitle") }</p>
			</div>
		</div>

		<form class="mt-8 flex flex-wrap gap-2 rounded-2xl border border-stone-200 bg-white p-4" method="post" action="/dashboard/menu/categories">
			<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
			<input class="min-w-0 flex-1 rounded-lg border border-stone-300 px-3 py-2" name="name" placeholder={ p.T("menu.new_category") } required maxlength="120"/>
			<button class="rounded-lg bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700" type="submit">{ p.T("menu.add_category") }</button>
		</form>

		if len(p.Menu) == 0 {
			<div class="mt-6 rounded-2xl border border-dashed border-stone-300 bg-white p-10 text-center text-stone-500">
				{ p.T("menu.empty") }
			</div>
		} else {
			<div class="mt-6 space-y-6">
				for _, c := range p.Menu {
					<section class="rounded-2xl border border-stone-200 bg-white p-6">
						<h2 class="text-lg font-semibold">{ c.Name }</h2>

						if len(c.Items) == 0 {
							<p class="mt-3 text-sm text-stone-500">{ p.T("menu.category_empty") }</p>
						} else {
							<ul class="mt-4 divide-y divide-stone-100">
								for _, it := range c.Items {
									<li class="flex flex-wrap items-center justify-between gap-3 py-3">
										<form class="flex flex-1 flex-wrap items-center gap-3" method="post" action={ templ.SafeURL("/dashboard/menu/items/" + it.ID) }>
											<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
											if it.ThumbURL != "" {
												<img src={ it.ThumbURL } alt={ it.Name } class="h-10 w-10 rounded-lg object-cover ring-1 ring-stone-200"/>
											}
											<input class="min-w-0 flex-1 rounded-lg border border-stone-300 px-3 py-2 text-sm" name="name" value={ it.Name } maxlength="160" required/>
											<input class="w-28 rounded-lg border border-stone-300 px-3 py-2 text-sm" name="price" value={ it.Price } inputmode="decimal" required/>
											<button class="rounded-lg border border-stone-300 px-3 py-2 text-sm font-medium hover:bg-stone-100" type="submit">{ p.T("menu.save") }</button>
										</form>
										<div class="flex flex-wrap items-center gap-3">
											if p.MediaEnabled {
												if it.ThumbURL != "" {
													<form method="post" action={ templ.SafeURL("/dashboard/menu/items/" + it.ID + "/image/delete") }>
														<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
														<button class="text-xs text-stone-500 hover:underline" type="submit">{ p.T("menu.remove_image") }</button>
													</form>
												} else {
													<form class="flex items-center gap-2" method="post" action={ templ.SafeURL("/dashboard/menu/items/" + it.ID + "/image") } enctype="multipart/form-data">
														<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
														<input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif" class="text-xs text-stone-500 file:mr-2 file:rounded-lg file:border-0 file:bg-stone-100 file:px-2 file:py-1 file:text-xs file:font-medium hover:file:bg-stone-200"/>
														<button class="rounded-lg border border-stone-300 px-2 py-1 text-xs font-medium hover:bg-stone-100" type="submit">{ p.T("menu.upload_image") }</button>
													</form>
												}
											}
											<form method="post" action={ templ.SafeURL("/dashboard/menu/items/" + it.ID + "/availability") }>
												<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
												if it.Available {
													<input type="hidden" name="available" value="0"/>
												} else {
													<input type="hidden" name="available" value="1"/>
												}
												<button class={ availabilityClass(it.Available) } type="submit">
													if it.Available {
														{ p.T("menu.available") }
													} else {
														{ p.T("menu.unavailable") }
													}
												</button>
											</form>
											<form method="post" action={ templ.SafeURL("/dashboard/menu/items/" + it.ID + "/delete") }>
												<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
												<button class="text-sm text-red-700 hover:underline" type="submit">{ p.T("menu.delete") }</button>
											</form>
										</div>
									</li>
								}
							</ul>
						}

						<form class="mt-4 flex flex-wrap gap-2 border-t border-stone-100 pt-4" method="post" action={ templ.SafeURL("/dashboard/menu/categories/" + c.ID + "/items") }>
							<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
							<input class="min-w-0 flex-1 rounded-lg border border-stone-300 px-3 py-2 text-sm" name="name" placeholder={ p.T("menu.new_item") } required maxlength="160"/>
							<input class="w-28 rounded-lg border border-stone-300 px-3 py-2 text-sm" name="price" placeholder={ p.T("menu.price") } inputmode="decimal" required/>
							<button class="rounded-lg bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700" type="submit">{ p.T("menu.add_item") }</button>
						</form>
					</section>
				}
			</div>
		}
	}
}

func availabilityClass(available bool) string {
	if available {
		return "rounded-full bg-emerald-100 px-3 py-1 text-xs font-medium text-emerald-800 hover:bg-emerald-200"
	}
	return "rounded-full bg-stone-200 px-3 py-1 text-xs font-medium text-stone-600 hover:bg-stone-300"
}
