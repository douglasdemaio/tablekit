package templates

templ DeliveryPage(p Page) {
	@Layout(p) {
		<h1 class="text-3xl font-semibold tracking-tight">{ p.T("delivery.title") }</h1>
		<p class="mt-2 text-stone-600">{ p.T("delivery.subtitle") }</p>

		if len(p.Deliveries) == 0 {
			<div class="mt-10 rounded-2xl border border-dashed border-stone-300 bg-white p-10 text-center text-stone-500">{ p.T("delivery.empty") }</div>
		} else {
			<div class="mt-8 space-y-4">
				for _, d := range p.Deliveries {
					<article class="rounded-2xl border border-stone-200 bg-white p-6">
						<div class="flex flex-wrap items-start justify-between gap-4">
							<div>
								<div class="flex items-center gap-3">
									<h2 class="text-lg font-semibold">{ d.Ref }</h2>
									@StatusBadge(d.StatusLabel)
								</div>
								<p class="mt-1 text-sm text-stone-500">{ p.T("delivery.scheduled") }: { d.Scheduled } · { d.Payment }</p>
								<p class="mt-1 text-sm text-stone-600">{ p.T("orders.customer") }: { d.Customer }</p>
								if d.Assignee != "" {
									<p class="mt-1 text-sm text-stone-600">{ p.T("delivery.driver") }: { d.Assignee }</p>
								}
							</div>
							<p class="text-lg font-semibold">{ d.Total }</p>
						</div>

						if d.Mine {
							<div class="mt-4 rounded-lg bg-stone-50 p-4 text-sm">
								if d.Phone != "" {
									<p><span class="font-medium">{ p.T("account.phone") }:</span> <a class="underline" href={ "tel:" + d.Phone }>{ d.Phone }</a></p>
								}
								if d.Address != "" {
									<p class="mt-1"><span class="font-medium">{ p.T("account.address") }:</span> { d.Address }</p>
								}
							</div>
						} else if d.Claimed {
							<p class="mt-4 rounded-lg bg-stone-50 px-4 py-3 text-sm text-stone-600">{ p.T("delivery.address_hidden") }</p>
						}

						if d.Notes != "" {
							<p class="mt-3 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-900">{ p.T("orders.notes") }: { d.Notes }</p>
						}

						if d.CanHandoff {
							<form method="post" action={ templ.SafeURL("/dashboard/orders/" + d.ID + "/handoff") } class="mt-5 flex flex-wrap items-end gap-2 rounded-lg bg-amber-50 p-3">
								<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
								<div>
									<label class="block text-sm font-medium text-amber-900">{ p.T("delivery.code") }</label>
									<input name="code" required maxlength="6" autocomplete="off" class="mt-1 w-36 rounded-lg border border-amber-300 px-3 py-2 font-mono uppercase tracking-widest"/>
								</div>
								<button type="submit" class="rounded-lg bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700">{ p.T("delivery.complete") }</button>
							</form>
						}

						<div class="mt-5 flex flex-wrap gap-2">
							if d.CanClaim {
								<form method="post" action={ templ.SafeURL("/dashboard/orders/" + d.ID + "/claim") }>
									<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
									<button class="rounded-lg bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700" type="submit">{ p.T("delivery.claim") }</button>
								</form>
							}
							if d.CanRelease {
								<form method="post" action={ templ.SafeURL("/dashboard/orders/" + d.ID + "/release") }>
									<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
									<button class="rounded-lg border border-stone-300 px-4 py-2 text-sm font-medium hover:bg-stone-100" type="submit">{ p.T("delivery.release") }</button>
								</form>
							}
							if d.CanAssign && len(p.Drivers) > 0 {
								<form method="post" action={ templ.SafeURL("/dashboard/orders/" + d.ID + "/assign") } class="flex items-end gap-2">
									<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
									<select name="staff_id" class="rounded-lg border border-stone-300 px-3 py-2 text-sm">
										for _, dr := range p.Drivers {
											<option value={ dr.ID }>{ dr.Name }</option>
										}
									</select>
									<button class="rounded-lg border border-stone-300 px-4 py-2 text-sm font-medium hover:bg-stone-100" type="submit">{ p.T("delivery.assign") }</button>
								</form>
							}
						</div>
					</article>
				}
			</div>
		}
	}
}
