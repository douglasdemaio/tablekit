package templates

templ CustomerLoginPage(p Page) {
	@Layout(p) {
		<div class="mx-auto max-w-md">
			<h1 class="text-3xl font-semibold tracking-tight">{ p.T("account.login_title") }</h1>
			<p class="mt-2 text-stone-600">{ p.T("account.login_subtitle") }</p>
			if p.Notice != "" {
				<div class="mt-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800" role="status">{ p.Notice }</div>
			}
			if p.Login.DevNotice {
				<p class="mt-4 rounded-lg bg-amber-50 px-4 py-3 text-sm text-amber-900">{ p.T("account.dev_notice") }</p>
			}

			if p.Login.Email == "" {
				<form method="post" action="/account/login" class="mt-6 space-y-4 rounded-2xl border border-stone-200 bg-white p-6">
					<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
					<input type="hidden" name="next" value={ p.Login.Next }/>
					<div>
						<label class="block text-sm font-medium" for="email">{ p.T("account.email") }</label>
						<input id="email" name="email" type="email" required maxlength="254" autocomplete="email"
							class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
					</div>
					<button class="w-full rounded-lg bg-stone-900 px-4 py-2.5 font-medium text-white hover:bg-stone-700" type="submit">{ p.T("account.send_code") }</button>
				</form>
			} else {
				<form method="post" action="/account/login/verify" class="mt-6 space-y-4 rounded-2xl border border-stone-200 bg-white p-6">
					<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
					<input type="hidden" name="next" value={ p.Login.Next }/>
					<input type="hidden" name="email" value={ p.Login.Email }/>
					<div>
						<label class="block text-sm font-medium" for="code">{ p.T("account.code") }</label>
						<input id="code" name="code" required inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code"
							class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 font-mono text-2xl tracking-[0.3em]"/>
					</div>
					<button class="w-full rounded-lg bg-stone-900 px-4 py-2.5 font-medium text-white hover:bg-stone-700" type="submit">{ p.T("account.sign_in") }</button>
				</form>
			}
		</div>
	}
}

templ AccountPage(p Page) {
	@Layout(p) {
		<div class="flex flex-wrap items-start justify-between gap-4">
			<div>
				<h1 class="text-3xl font-semibold tracking-tight">{ p.T("account.title") }</h1>
				<p class="mt-1 text-stone-600">{ p.Account.Email }</p>
			</div>
			<form method="post" action="/account/logout">
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
				<button class="rounded-md border border-stone-300 px-3 py-1.5 text-sm hover:bg-stone-100" type="submit">{ p.T("nav.logout") }</button>
			</form>
		</div>

		<section class="mt-8 rounded-2xl border border-stone-200 bg-white p-6">
			<h2 class="text-lg font-semibold">{ p.T("account.profile") }</h2>
			<form method="post" action="/account/profile" class="mt-4 grid gap-3 sm:grid-cols-2">
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
				<div>
					<label class="block text-sm font-medium" for="name">{ p.T("account.name") }</label>
					<input id="name" name="name" value={ p.Account.Name } maxlength="120" autocomplete="name"
						class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
				</div>
				<div>
					<label class="block text-sm font-medium" for="phone">{ p.T("account.phone") }</label>
					<input id="phone" name="phone" value={ p.Account.Phone } maxlength="40" autocomplete="tel"
						class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
				</div>
				<div class="sm:col-span-2">
					<button class="rounded-lg bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700" type="submit">{ p.T("common.save") }</button>
				</div>
			</form>
		</section>

		<section id="addresses" class="mt-8 rounded-2xl border border-stone-200 bg-white p-6">
			<h2 class="text-lg font-semibold">{ p.T("account.addresses") }</h2>
			if len(p.Account.Addresses) == 0 {
				<p class="mt-2 text-sm text-stone-500">{ p.T("account.no_addresses") }</p>
			}
			<div class="mt-4 space-y-4">
				for _, a := range p.Account.Addresses {
					<div class="rounded-xl border border-stone-200 p-4">
						<div class="flex flex-wrap items-center justify-between gap-2">
							<div>
								<p class="font-medium">{ a.Label } <span class="text-sm text-stone-500">{ a.Recipient }</span></p>
								<p class="text-sm text-stone-600">{ a.Summary }</p>
							</div>
							if a.IsDefault {
								<span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-medium text-emerald-800">{ p.T("account.default") }</span>
							}
						</div>
						<details class="mt-3">
							<summary class="cursor-pointer text-sm text-stone-600">{ p.T("account.edit_address") }</summary>
							<form method="post" action={ "/account/addresses/" + a.ID } class="mt-3 grid gap-3 sm:grid-cols-2">
								<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
								@addressFields(p, a)
								<label class="flex items-center gap-2 text-sm sm:col-span-2">
									<input type="checkbox" name="is_default" value="1" checked?={ a.IsDefault }/>
									{ p.T("account.make_default") }
								</label>
								<div class="flex gap-2 sm:col-span-2">
									<button class="rounded-lg bg-stone-900 px-3 py-2 text-sm font-medium text-white hover:bg-stone-700" type="submit">{ p.T("common.save") }</button>
								</div>
							</form>
							<div class="mt-3 flex flex-wrap gap-2">
								if !a.IsDefault {
									<form method="post" action={ "/account/addresses/" + a.ID + "/default" }>
										<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
										<button class="rounded-lg border border-stone-300 px-3 py-1.5 text-sm hover:bg-stone-100" type="submit">{ p.T("account.make_default") }</button>
									</form>
								}
								<form method="post" action={ "/account/addresses/" + a.ID + "/delete" }>
									<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
									<button class="rounded-lg border border-red-200 px-3 py-1.5 text-sm text-red-700 hover:bg-red-50" type="submit">{ p.T("common.delete") }</button>
								</form>
							</div>
						</details>
					</div>
				}
			</div>

			<details class="mt-6" open?={ len(p.Account.Addresses) == 0 }>
				<summary class="cursor-pointer font-medium">{ p.T("account.add_address") }</summary>
				<form method="post" action="/account/addresses" class="mt-4 grid gap-3 sm:grid-cols-2">
					<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
					@addressFields(p, AddressView{Country: "DE"})
					<label class="flex items-center gap-2 text-sm sm:col-span-2">
						<input type="checkbox" name="is_default" value="1"/>
						{ p.T("account.make_default") }
					</label>
					<div class="sm:col-span-2">
						<button class="rounded-lg bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700" type="submit">{ p.T("account.add_address") }</button>
					</div>
				</form>
			</details>
		</section>

		<section class="mt-8 rounded-2xl border border-stone-200 bg-white p-6">
			<h2 class="text-lg font-semibold">{ p.T("account.sharing") }</h2>
			<p class="mt-1 text-sm text-stone-600">{ p.T("account.sharing_hint") }</p>
			if p.Account.SharedHere {
				<p class="mt-3 rounded-lg bg-emerald-50 px-4 py-3 text-sm text-emerald-800">{ p.T("account.shared_here") } { p.Account.Restaurant }</p>
			} else {
				<p class="mt-3 rounded-lg bg-stone-50 px-4 py-3 text-sm text-stone-600">{ p.T("account.not_shared_here") } { p.Account.Restaurant }</p>
			}
			if len(p.Account.Shares) > 0 {
				<ul class="mt-4 divide-y divide-stone-100">
					for _, sh := range p.Account.Shares {
						<li class="flex flex-wrap items-center justify-between gap-2 py-3 text-sm">
							<div>
								<a class="font-medium underline" href={ sh.URL }>{ sh.Name }</a>
								<span class="ml-2 text-stone-500">{ sh.Created }</span>
							</div>
							<form method="post" action={ "/account/shares/" + sh.MerchantID + "/revoke" }>
								<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
								<button class="rounded-lg border border-stone-300 px-3 py-1.5 text-sm hover:bg-stone-100" type="submit">{ p.T("account.revoke") }</button>
							</form>
						</li>
					}
				</ul>
			}
		</section>

		<p class="mt-6 text-sm"><a class="underline" href="/account/orders">{ p.T("account.my_orders") }</a></p>
	}
}

templ addressFields(p Page, a AddressView) {
	<div>
		<label class="block text-sm font-medium">{ p.T("account.label") }</label>
		<input name="label" value={ a.Label } maxlength="60" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
	</div>
	<div>
		<label class="block text-sm font-medium">{ p.T("account.recipient") }</label>
		<input name="recipient" value={ a.Recipient } required maxlength="120" autocomplete="name" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
	</div>
	<div>
		<label class="block text-sm font-medium">{ p.T("account.phone") }</label>
		<input name="phone" value={ a.Phone } required maxlength="40" autocomplete="tel" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
	</div>
	<div>
		<label class="block text-sm font-medium">{ p.T("account.street") }</label>
		<input name="line1" value={ a.Line1 } required maxlength="200" autocomplete="address-line1" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
	</div>
	<div>
		<label class="block text-sm font-medium">{ p.T("account.line2") }</label>
		<input name="line2" value={ a.Line2 } maxlength="200" autocomplete="address-line2" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
	</div>
	<div>
		<label class="block text-sm font-medium">{ p.T("account.postcode") }</label>
		<input name="postcode" value={ a.Postcode } required maxlength="12" autocomplete="postal-code" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
	</div>
	<div>
		<label class="block text-sm font-medium">{ p.T("account.city") }</label>
		<input name="city" value={ a.City } required maxlength="120" autocomplete="address-level2" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
	</div>
	<div>
		<label class="block text-sm font-medium">{ p.T("account.country") }</label>
		<input name="country" value={ a.Country } required minlength="2" maxlength="2" autocomplete="country" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
	</div>
	<div class="sm:col-span-2">
		<label class="block text-sm font-medium">{ p.T("account.delivery_notes") }</label>
		<input name="delivery_notes" value={ a.Notes } maxlength="500" class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2"/>
	</div>
}


templ AccountOrdersPage(p Page) {
	@Layout(p) {
		<h1 class="text-3xl font-semibold tracking-tight">{ p.T("account.orders_title") }</h1>
		<p class="mt-2"><a class="underline" href="/account">{ p.T("account.back") }</a></p>
		if len(p.AccountOrders) == 0 {
			<p class="mt-8 rounded-2xl border border-dashed border-stone-300 bg-white p-8 text-center text-stone-500">{ p.T("account.no_orders") }</p>
		} else {
			<ul class="mt-6 divide-y divide-stone-200 rounded-2xl border border-stone-200 bg-white">
				for _, o := range p.AccountOrders {
					<li class="flex flex-wrap items-center justify-between gap-3 p-4">
						<div>
							<a class="font-medium underline" href={ "/account/orders/" + o.Ref }>{ o.Ref }</a>
							<p class="text-sm text-stone-500">{ o.Placed } · { o.Fulfilment } · { o.Payment }</p>
						</div>
						<div class="text-right">
							<p class="font-medium">{ o.Total }</p>
							<p class="text-sm text-stone-500">{ o.StatusLabel }</p>
						</div>
					</li>
				}
			</ul>
		}
	}
}

templ AccountOrderPage(p Page) {
	@Layout(p) {
		<div class="rounded-2xl border border-stone-200 bg-white p-8">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<div>
					<p class="text-sm uppercase tracking-wide text-stone-500">{ p.T("account.order_title") }</p>
					<h1 class="mt-1 text-3xl font-semibold tracking-tight">{ p.AccountOrder.Ref }</h1>
				</div>
				@StatusBadge(p.AccountOrder.Status)
			</div>
			<dl class="mt-6 grid gap-2 text-sm sm:grid-cols-2">
				<div><dt class="text-stone-500">{ p.T("orders.fulfilment") }</dt><dd class="font-medium">{ p.AccountOrder.Fulfilment }</dd></div>
				<div><dt class="text-stone-500">{ p.T("account.payment") }</dt><dd class="font-medium">{ p.AccountOrder.Payment }</dd></div>
				<div><dt class="text-stone-500">{ p.T("account.placed") }</dt><dd class="font-medium">{ p.AccountOrder.Placed }</dd></div>
				if p.AccountOrder.Scheduled != "" {
					<div><dt class="text-stone-500">{ p.T("account.scheduled") }</dt><dd class="font-medium">{ p.AccountOrder.Scheduled }</dd></div>
				}
			</dl>
			if p.AccountOrder.Code != "" {
				<div class="mt-6 rounded-2xl bg-amber-50 p-5">
					<p class="text-sm font-medium text-amber-900">{ p.T("order.pickup_code") }</p>
					<p class="mt-1 font-mono text-4xl font-semibold tracking-[0.3em] text-amber-900">{ p.AccountOrder.Code }</p>
				</div>
			}
			<ul class="mt-6 divide-y divide-stone-100 border-t border-stone-100">
				for _, line := range p.AccountOrder.Items {
					<li class="flex items-center justify-between py-2 text-sm">
						<span><span class="font-medium">{ line.Quantity }×</span> { line.Name }</span>
						<span class="text-stone-500">{ line.Total }</span>
					</li>
				}
			</ul>
			<div class="mt-4 space-y-1 border-t border-stone-100 pt-3 text-sm">
				<div class="flex justify-between"><span class="text-stone-500">{ p.T("order.subtotal") }</span><span>{ p.AccountOrder.Subtotal }</span></div>
				<div class="flex justify-between"><span class="text-stone-500">{ p.T("order.delivery_fee") }</span><span>{ p.AccountOrder.Fee }</span></div>
				<div class="flex justify-between"><span class="text-stone-500">{ p.T("order.vat_included") }</span><span>{ p.AccountOrder.Tax }</span></div>
				<div class="flex justify-between text-base font-semibold"><span>{ p.T("cart.total") }</span><span>{ p.AccountOrder.Total }</span></div>
			</div>
		</div>
		<p class="mt-4 text-sm"><a class="underline" href="/account/orders">{ p.T("account.back") }</a></p>
	}
}
