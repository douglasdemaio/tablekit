package templates

templ Landing(p Page) {
	@Layout(p) {
		if p.MerchantName != "" {
			<div class="mx-auto max-w-xl rounded-2xl border border-stone-200 bg-white p-8 shadow-sm">
				<p class="text-sm font-medium uppercase tracking-widest text-amber-600">{ p.T("tenant.eyebrow") }</p>
				<h1 class="mt-3 text-3xl font-semibold tracking-tight">{ p.MerchantName }</h1>
				<p class="mt-4 text-stone-600">{ p.T("tenant.subtitle") }</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a class="rounded-lg bg-stone-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-stone-700" href="/login">{ p.T("tenant.for_team") }</a>
				</div>
			</div>
		} else {
			<div class="max-w-3xl">
				<p class="text-sm font-medium uppercase tracking-widest text-amber-600">{ p.T("landing.eyebrow") }</p>
				<h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">{ p.T("landing.title") }</h1>
				<p class="mt-5 max-w-2xl text-lg text-stone-600">{ p.T("landing.subtitle") }</p>
				<ul class="mt-8 grid gap-4 sm:grid-cols-3">
					<li class="rounded-xl border border-stone-200 bg-white p-5">
						<h2 class="font-medium">{ p.T("landing.feature1.title") }</h2>
						<p class="mt-2 text-sm text-stone-600">{ p.T("landing.feature1.body") }</p>
					</li>
					<li class="rounded-xl border border-stone-200 bg-white p-5">
						<h2 class="font-medium">{ p.T("landing.feature2.title") }</h2>
						<p class="mt-2 text-sm text-stone-600">{ p.T("landing.feature2.body") }</p>
					</li>
					<li class="rounded-xl border border-stone-200 bg-white p-5">
						<h2 class="font-medium">{ p.T("landing.feature3.title") }</h2>
						<p class="mt-2 text-sm text-stone-600">{ p.T("landing.feature3.body") }</p>
					</li>
				</ul>
				<div class="mt-8 flex gap-3">
					<a class="rounded-lg bg-stone-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-stone-700" href="/login">{ p.T("landing.login") }</a>
				</div>
			</div>
		}
	}
}

templ LoginPage(p Page) {
	@Layout(p) {
		<div class="mx-auto max-w-md">
			<h1 class="text-2xl font-semibold tracking-tight">{ p.T("login.title") }</h1>
			<p class="mt-2 text-sm text-stone-600">{ p.T("login.subtitle", "merchant", p.MerchantName) }</p>

			<form class="mt-8 space-y-4 rounded-2xl border border-stone-200 bg-white p-6" method="post" action="/login">
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
				<div>
					<label class="block text-sm font-medium" for="email">{ p.T("login.email") }</label>
					<input class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2" id="email" name="email" type="email" autocomplete="username webauthn" required/>
				</div>
				<div>
					<label class="block text-sm font-medium" for="password">{ p.T("login.password") }</label>
					<input class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2" id="password" name="password" type="password" autocomplete="current-password"/>
				</div>
				<button class="w-full rounded-lg bg-stone-900 px-4 py-2.5 text-sm font-medium text-white hover:bg-stone-700" type="submit">{ p.T("login.submit") }</button>
			</form>

			<div class="mt-4 rounded-2xl border border-stone-200 bg-white p-6">
				<p class="text-sm font-medium">{ p.T("login.passkey_title") }</p>
				<p class="mt-1 text-sm text-stone-600">{ p.T("login.passkey_body") }</p>
				<button class="mt-4 w-full rounded-lg border border-stone-300 px-4 py-2.5 text-sm font-medium hover:bg-stone-100" type="button" data-passkey-login>{ p.T("login.passkey_button") }</button>
				<p class="mt-3 hidden text-sm text-red-700" data-passkey-error role="alert"></p>
			</div>
		</div>
	}
}

templ MFAPage(p Page) {
	@Layout(p) {
		<div class="mx-auto max-w-md">
			<h1 class="text-2xl font-semibold tracking-tight">{ p.T("mfa.title") }</h1>
			<p class="mt-2 text-sm text-stone-600">{ p.T("mfa.subtitle") }</p>
			<form class="mt-8 space-y-4 rounded-2xl border border-stone-200 bg-white p-6" method="post" action="/login/mfa">
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
				<div>
					<label class="block text-sm font-medium" for="code">{ p.T("mfa.code") }</label>
					<input class="mt-1 w-full rounded-lg border border-stone-300 px-3 py-2 tracking-[0.3em]" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required autofocus/>
				</div>
				<button class="w-full rounded-lg bg-stone-900 px-4 py-2.5 text-sm font-medium text-white hover:bg-stone-700" type="submit">{ p.T("mfa.submit") }</button>
			</form>
		</div>
	}
}

templ SetupPage(p Page) {
	@Layout(p) {
		<div class="mx-auto max-w-xl">
			<h1 class="text-2xl font-semibold tracking-tight">{ p.T("setup.title") }</h1>
			<p class="mt-2 text-sm text-stone-600">{ p.T("setup.subtitle") }</p>

			<div class="mt-8 rounded-2xl border border-stone-200 bg-white p-6">
				<h2 class="font-medium">{ p.T("setup.app_title") }</h2>
				<p class="mt-1 text-sm text-stone-600">{ p.T("setup.app_body") }</p>
				<div class="mt-4 flex flex-col gap-6 sm:flex-row">
					if p.QRDataURI != "" {
						<img class="h-40 w-40 rounded-lg border border-stone-200" src={ p.QRDataURI } alt={ p.T("setup.app_title") } width="160" height="160"/>
					}
					<div class="min-w-0 flex-1">
						<p class="text-xs uppercase tracking-wide text-stone-500">{ p.T("setup.manual_key") }</p>
						<code class="mt-1 block break-all rounded-lg bg-stone-100 px-3 py-2 text-sm">{ p.SetupSecret }</code>
						<form class="mt-4 flex gap-2" method="post" action="/setup/totp/verify">
							<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
							<input class="w-full rounded-lg border border-stone-300 px-3 py-2 tracking-[0.3em]" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="123456" required/>
							<button class="shrink-0 rounded-lg bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700" type="submit">{ p.T("setup.activate") }</button>
						</form>
					</div>
				</div>
			</div>

			<div class="mt-4 rounded-2xl border border-stone-200 bg-white p-6">
				<h2 class="font-medium">{ p.T("setup.passkey_title") }</h2>
				<p class="mt-1 text-sm text-stone-600">{ p.T("setup.passkey_body") }</p>
				<button class="mt-4 rounded-lg border border-stone-300 px-4 py-2.5 text-sm font-medium hover:bg-stone-100" type="button" data-passkey-register data-begin="/setup/passkey/begin" data-finish="/setup/passkey/finish" data-redirect="/dashboard">{ p.T("setup.passkey_button") }</button>
				<p class="mt-3 hidden text-sm text-red-700" data-passkey-error role="alert"></p>
			</div>
		</div>
	}
}

templ DashboardPage(p Page) {
	@Layout(p) {
		<div class="flex flex-wrap items-end justify-between gap-4">
			<div>
				<p class="text-sm uppercase tracking-widest text-amber-600">{ p.StaffRole }</p>
				<h1 class="mt-2 text-3xl font-semibold tracking-tight">{ p.T("dashboard.welcome", "name", p.StaffName) }</h1>
				<p class="mt-1 text-stone-600">{ p.T("dashboard.tenant", "merchant", p.MerchantName, "slug", p.MerchantSlug) }</p>
			</div>
		</div>

		<div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			<div class="rounded-2xl border border-stone-200 bg-white p-6">
				<p class="text-sm text-stone-500">{ p.T("dashboard.open_orders") }</p>
				<p class="mt-2 text-3xl font-semibold">{ p.Stats.OpenOrders }</p>
			</div>
			<div class="rounded-2xl border border-stone-200 bg-white p-6">
				<p class="text-sm text-stone-500">{ p.T("dashboard.today_orders") }</p>
				<p class="mt-2 text-3xl font-semibold">{ p.Stats.TodayOrders }</p>
			</div>
			<div class="rounded-2xl border border-stone-200 bg-white p-6">
				<p class="text-sm text-stone-500">{ p.T("dashboard.revenue") }</p>
				<p class="mt-2 text-3xl font-semibold">{ p.Stats.Revenue }</p>
			</div>
			<div class="rounded-2xl border border-stone-200 bg-white p-6">
				<p class="text-sm text-stone-500">{ p.T("dashboard.menu_items") }</p>
				<p class="mt-2 text-3xl font-semibold">{ p.Stats.MenuItems }</p>
			</div>
		</div>

		<div class="mt-8 flex flex-wrap gap-3">
			<a class="rounded-lg bg-stone-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-stone-700" href="/dashboard/orders">{ p.T("dashboard.view_orders") }</a>
			<a class="rounded-lg border border-stone-300 px-5 py-2.5 text-sm font-medium hover:bg-stone-100" href="/dashboard/menu">{ p.T("dashboard.manage_menu") }</a>
		</div>
	}
}

templ SecurityPage(p Page) {
	@Layout(p) {
		<h1 class="text-3xl font-semibold tracking-tight">{ p.T("security.title") }</h1>
		<p class="mt-2 text-stone-600">{ p.T("security.subtitle") }</p>

		<section class="mt-8 rounded-2xl border border-stone-200 bg-white p-6">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<div>
					<h2 class="font-medium">{ p.T("security.totp_title") }</h2>
					<p class="mt-1 text-sm text-stone-600">
						if p.TOTPEnabled {
							{ p.T("security.totp_on") }
						} else {
							{ p.T("security.totp_off") }
						}
					</p>
				</div>
				if p.TOTPEnabled {
					<form method="post" action="/dashboard/security/totp/disable">
						<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
						<button class="rounded-lg border border-red-300 px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-50" type="submit">{ p.T("security.totp_disable") }</button>
					</form>
				} else {
					<form method="post" action="/dashboard/security/totp/begin">
						<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
						<button class="rounded-lg bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700" type="submit">{ p.T("security.totp_setup") }</button>
					</form>
				}
			</div>
		</section>

		<section class="mt-4 rounded-2xl border border-stone-200 bg-white p-6">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<div>
					<h2 class="font-medium">{ p.T("security.passkeys_title") }</h2>
					<p class="mt-1 text-sm text-stone-600">{ p.T("security.passkeys_body") }</p>
				</div>
				<button class="rounded-lg bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700" type="button" data-passkey-register data-begin="/dashboard/security/passkeys/begin" data-finish="/dashboard/security/passkeys/finish">{ p.T("security.passkey_add") }</button>
			</div>
			<p class="mt-3 hidden text-sm text-red-700" data-passkey-error role="alert"></p>
			if len(p.Passkeys) == 0 {
				<p class="mt-4 text-sm text-stone-500">{ p.T("security.passkey_none") }</p>
			} else {
				<ul class="mt-4 divide-y divide-stone-100">
					for _, pk := range p.Passkeys {
						<li class="flex flex-wrap items-center justify-between gap-3 py-3">
							<div>
								<p class="text-sm font-medium">{ pk.Name }</p>
								<p class="text-xs text-stone-500">{ p.T("security.passkey_created", "date", pk.Created, "last", pk.LastUsed) }</p>
							</div>
							<form method="post" action={ templ.SafeURL("/dashboard/security/passkeys/" + pk.ID + "/delete") }>
								<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
								<button class="text-sm text-red-700 hover:underline" type="submit">{ p.T("security.passkey_remove") }</button>
							</form>
						</li>
					}
				</ul>
			}
		</section>

		<section class="mt-4 rounded-2xl border border-stone-200 bg-white p-6">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<div>
					<h2 class="font-medium">{ p.T("security.sessions_title") }</h2>
					<p class="mt-1 text-sm text-stone-600">{ p.T("security.sessions_body", "ttl", p.SessionTTL) }</p>
				</div>
				<form method="post" action="/dashboard/security/sessions/revoke-others">
					<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
					<button class="rounded-lg border border-stone-300 px-4 py-2 text-sm font-medium hover:bg-stone-100" type="submit">{ p.T("security.revoke_others") }</button>
				</form>
			</div>
			<ul class="mt-4 divide-y divide-stone-100">
				for _, s := range p.Sessions {
					<li class="flex flex-wrap items-center justify-between gap-3 py-3">
						<div>
							<p class="text-sm font-medium">
								if s.Current {
									{ p.T("security.sessions_this") }
								} else {
									{ s.IP }
								}
							</p>
							<p class="text-xs text-stone-500">{ p.T("security.sessions_last", "ua", s.UserAgent, "last", s.LastSeen) }</p>
						</div>
						if !s.Current {
							<form method="post" action={ templ.SafeURL("/dashboard/security/sessions/" + s.ID + "/revoke") }>
								<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
								<button class="text-sm text-red-700 hover:underline" type="submit">{ p.T("security.revoke") }</button>
							</form>
						}
					</li>
				}
			</ul>
		</section>
	}
}
